# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO - APOLLYON CLOUD
# ==============================================================================
# DICA: Para usar, renomeie este arquivo para ".env.local" e preencha os valores.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados e Autenticação)
# Onde pegar: Painel do Supabase > Project Settings > API
# ------------------------------------------------------------------------------

# Copie o "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-do-projeto.supabase.co

# Copie a "anon" / "public" key (NÃO use a service_role key aqui!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Copie a "service_role" key (Necessária para o Webhook funcionar sem usuário logado)
# CUIDADO: Essa chave tem poder total sobre o banco. Nunca exponha no frontend!
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# ------------------------------------------------------------------------------
# 2. MERCADO PAGO (Pagamentos)
# Onde pegar: Painel do Mercado Pago > Seu Negócio > Configurações > Gestão e Administração > Credenciais
# Use as "Credenciais de Produção" para valer, ou "Teste" para desenvolver.
# ------------------------------------------------------------------------------

# Access Token (Começa com APP_USR-...)
MP_ACCESS_TOKEN=APP_USR-seu-token-de-acesso-aqui

# (Opcional) Webhook Secret - Para verificar se o aviso de pagamento é real
# Onde pegar: Configure o Webhook no MP e ele te dará um "Secret"
MP_WEBHOOK_SECRET=seu-segredo-do-webhook-aqui

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES DO APP
# ------------------------------------------------------------------------------

# URL base do seu site (usado para redirecionamento após login/pagamento)
# Em desenvolvimento: http://localhost:3000
# Em produção (Vercel): https://seu-projeto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
